###############################################################################
# KynexEdu SaaS School Information System - Environment Configuration
###############################################################################

APP_NAME="KynexEdu ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Application URL - The main domain for the SaaS platform
# Example: https://kynexedu.com or http://localhost:8000
APP_URL=http://localhost:8000

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# DATABASE (PostgreSQL) - Central/Landlord Database
###############################################################################

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kynexedu_central
DB_USERNAME=postgres
DB_PASSWORD=

###############################################################################
# PGBOUNCER — Connection Pooling (Production)
# Point DB_HOST/DB_PORT at PgBouncer instead of PostgreSQL directly.
# See docs/pgbouncer-setup.md for setup instructions.
###############################################################################

PGBOUNCER_HOST=127.0.0.1
PGBOUNCER_PORT=6432
# In production, set DB_PORT=6432 to route through PgBouncer
# DB_PORT=${PGBOUNCER_PORT}
DB_PERSISTENT=false

###############################################################################
# TENANCY - Multi-tenant Database Configuration
# Each tenant (school) gets its own database automatically.
# The central database stores tenant metadata, plans, subscriptions, etc.
###############################################################################

# Tenant database prefix (tenant DBs will be named: kynexedu_tenant_{id})
TENANCY_DB_PREFIX=kynexedu_tenant_
# Tenant database host (same as central unless using separate DB servers)
TENANCY_DB_HOST=127.0.0.1
TENANCY_DB_PORT=5432
TENANCY_DB_USERNAME=postgres
TENANCY_DB_PASSWORD=

###############################################################################
# CACHE, SESSION & QUEUE
###############################################################################

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

# Redis (optional - recommended for production)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# MAIL - Resend Configuration
# Used for sending transactional emails (onboarding, notifications, etc.)
# Get your API key at: https://resend.com/api-keys
###############################################################################

MAIL_MAILER=resend
RESEND_API_KEY=re_xxxxxxxxxxxx

# Fallback/alternative SMTP config
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@kynexedu.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# SMS GATEWAY — Android SMS Gateway (capcom6/android-sms-gateway)
# Send SMS through your Android phone as a gateway device.
# Install app: https://github.com/capcom6/android-sms-gateway
# Docs: https://docs.sms-gate.app/
#
# NOTE: These are fallback env values. Primary config is managed via
# the SaaS Admin Panel → Settings → API Settings page (stored in DB).
###############################################################################

SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_URL=https://sms.example.com
SMS_GATEWAY_LOGIN=
SMS_GATEWAY_PASSWORD=

###############################################################################
# WHATSAPP — Evolution API Integration
# Self-hosted WhatsApp API for messaging, notifications, and alerts.
# GitHub: https://github.com/EvolutionAPI/evolution-api
# Docs: https://doc.evolution-api.com/
#
# NOTE: These are fallback env values. Primary config is managed via
# the SaaS Admin Panel → Settings → API Settings page (stored in DB).
###############################################################################

WHATSAPP_ENABLED=false
WHATSAPP_EVOLUTION_URL=https://evolution.yourdomain.com
WHATSAPP_EVOLUTION_TOKEN=your-evolution-api-token-here
WHATSAPP_EVOLUTION_INSTANCE=kynexedu-main
WHATSAPP_WEBHOOK_URL=
# Token you configure in the Meta App Dashboard → Webhooks → Verify Token
WHATSAPP_VERIFY_TOKEN=your-meta-webhook-verify-token-here

# KynexEdu official WhatsApp number for onboarding emails/support
# Format: country code + number (e.g., 923001234567)
KYNEX_WHATSAPP=923001234567

###############################################################################
# AI — OpenRouter (openrouter.ai)
# Unified API for 100+ AI models (GPT-4, Claude, Gemini, Llama, etc.)
# Get your API key at: https://openrouter.ai/keys
#
# ⚠️  A valid API key is REQUIRED to enable any AI features.
#
# NOTE: These are fallback env values. Primary config is managed via
# the SaaS Admin Panel → Settings → API Settings page (stored in DB).
###############################################################################

AI_ENABLED=false
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://kynexedu.com
OPENROUTER_SITE_NAME="KynexEdu ERP"
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_MONTHLY_BUDGET=50

###############################################################################
# SAAS ADMIN - Super Admin Credentials
# These are used during initial seeding to create the first super admin user
# who manages the entire SaaS platform (tenants, plans, billing, etc.)
###############################################################################

SAAS_ADMIN_EMAIL=admin@kynexedu.com
SAAS_ADMIN_PASSWORD=change-me-in-production

###############################################################################
# FILAMENT - Admin Panel Configuration
###############################################################################

FILAMENT_FILESYSTEM_DISK=public

###############################################################################
# VITE - Frontend Build
###############################################################################

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# PAYMENT GATEWAYS — JazzCash & EasyPaisa (Pakistani Payment Methods)
###############################################################################

# JazzCash Configuration
# Register at: https://sandbox.jazzcash.com.pk/
JAZZCASH_ENABLED=false
JAZZCASH_ENVIRONMENT=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL="${APP_URL}/payment/return"

# EasyPaisa Configuration
# Register at: https://easypay.easypaisa.com.pk/
EASYPAISA_ENABLED=false
EASYPAISA_ENVIRONMENT=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

###############################################################################
# DEMO TENANT — Used by kynex:reset-demo command
###############################################################################

DEMO_TENANT_ID=demo

###############################################################################
# FIREBASE CLOUD MESSAGING (FCM) — Push Notifications
# Used for sending push notifications to mobile apps.
# Get credentials from Firebase Console → Project Settings → Cloud Messaging.
###############################################################################

FCM_SERVER_KEY=your-firebase-server-key-here
FCM_PROJECT_ID=your-firebase-project-id-here

###############################################################################
# AWS (optional - for S3 storage in production)
###############################################################################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
